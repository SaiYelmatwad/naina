# Copy to .env and adjust for local/dev use. docker-compose.yml sets these
# directly for the containerized setup; this file matters when running the
# backend outside Docker (e.g. `uvicorn app.main:app --reload`).

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/signalwork
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO

# Optional: only used if you wire in a real embeddings API in
# app/matching/embeddings.py (see LLMEmbeddingProvider). Unset = the app
# uses the local TF-IDF matcher, which needs no key at all.
EMBEDDINGS_API_KEY=
